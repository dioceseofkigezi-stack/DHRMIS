# Supabase Project Configuration
# Create a Supabase project at https://app.supabase.com
# Then copy your project URL and one public client key below.
# Use the publishable key for new projects, or the anon JWT on older projects.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required when document upload/download is enabled
VITE_HR_DOCUMENTS_BUCKET=hr-documents

# Optional: SMTP for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=email@example.com
# SMTP_PASS=your-password 

# Optional: Break-glass credentials (activated manually, logged, auto-expire)
BREAK_GLASS_SECRET_KEY=your-secure-break-glass-key-here

# Application
VITE_APP_NAME=Diocese of Kigezi HRMIS
VITE_APP_ENV=development
